# PostgreSQL connection string (Render provides this)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string — signs the session cookie
SESSION_SECRET=

# App login (MULTI_INSTANCE_PILOT_SPEC.md WS1). Leave unset for no login
# gate (single-owner instance, historical behaviour). Set a password on any
# instance whose URL is shared with a customer.
# APP_PASSWORD=

# Xero OAuth app — from developer.xero.com. The redirect URI must also be
# listed on the Xero app's configuration page.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://your-app-name.onrender.com/auth/xero/callback

# Public URL of this instance
APP_URL=https://your-app-name.onrender.com

# Optional: Google Places (New) key for client address autocomplete
# GOOGLE_MAPS_API_KEY=

# Personal Debt Management App at /debt (MULTI_INSTANCE_PILOT_SPEC.md WS2).
# Default OFF — set true ONLY on the owner's personal instance, and run
# db/setup-debt.sql on its database. Customer instances leave this unset.
# DEBT_APP_ENABLED=true

# Optional: ntfy.sh topic for Debt app notifications (personal instance only)
# NTFY_TOPIC=

# PORT defaults to 3000; Render sets it automatically
# PORT=3000
